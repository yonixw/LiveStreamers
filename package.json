{
  "name": "live-streamers-circles",
  "version": "1.9.0",
  "description": "Cross-platform Electron app with live streamers overlay for status",
  "main": "src/main.js",
  "type": "commonjs",
  "author": "Yoni <yoni-common@5gbinbox.com>",
  "scripts": {
    "start": "bun x electron .",
    "dev": "bun x electron .",
    "build:win": "bun x electron-builder --win",
    "build:mac": "bun x electron-builder --mac",
    "build:linux": "bun x electron-builder --linux",
    "build:all": "bun x electron-builder -mwl",
    "dist": "bun x electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.livestreamers-overlay",
    "productName": "LiveStreamersCircles",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        "zip"
      ]
    },
    "mac": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ]
    }
  },
  "keywords": [
    "electron",
    "boilerplate",
    "transparent-window",
    "overlay",
    "tray"
  ],
  "license": "MIT",
  "dependencies": {
    "yt-dlp-wrap-plus": "^2.5.0"
  }
}
